{
  "functions": {
    "src/app/api/etl/gdrive-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/etl/meta-ad-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/etl/meta-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/etl/ga4-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/dashboard/meta/video/[videoId]/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/etl/gdrive-sync?mode=daily",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/etl/gdrive-sync?mode=poll",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/etl/ga4-sync",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/etl/meta-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/etl/meta-ad-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/sensmax/sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/sensmax/sales-sync",
      "schedule": "30 4 * * *"
    }
  ]
}
