# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_KEY=xxx

# Meta Ads — osobna apka Meta (i osobny System User token) per marka,
# bo każde portfolio biznesowe w Meta trzyma inny ad account.
# Format: act_<id>:<token>, pary oddzielone przecinkami.
META_AD_ACCOUNTS=act_111:EAA_mybedpl_token,act_222:EAA_mybedde_token,act_333:EAA_mitto_token

# Pinterest Ads
PINTEREST_ACCESS_TOKEN=xxx
PINTEREST_AD_ACCOUNT_ID=xxx

# GA4 (multiple properties, comma-separated)
GA4_PROPERTY_IDS=298581907,478191159,473912359

# App
NEXT_PUBLIC_APP_URL=https://panel.mybed.pl
ETL_CRON_SECRET=xxx

# Claude API (Creative AI Tagging — vision classification of ad thumbnails)
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Drive Auto-Import
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_DRIVE_FOLDER_ID=1abc...xyz
